// =============================================
// UPI Fraud Detection — Prisma Schema
// =============================================
// Tables: User, Transaction, Alert
// Database: PostgreSQL
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User ────────────────────────────────────────────────
// Represents a UPI user (sender or receiver)
model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255) // bcrypt hash
  upiId     String   @unique @map("upi_id") @db.VarChar(100)
  phone     String?  @db.VarChar(15)
  balance   Decimal  @default(10000.00) @db.Decimal(12, 2)
  isActive  Boolean  @default(true) @map("is_active")
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  sentTransactions     Transaction[] @relation("SenderTransactions")
  receivedTransactions Transaction[] @relation("ReceiverTransactions")
  alerts               Alert[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
  ANALYST
}

// ── Transaction ─────────────────────────────────────────
// Each UPI payment/transfer
model Transaction {
  id              Int             @id @default(autoincrement())
  transactionId   String          @unique @map("transaction_id") @db.VarChar(50)
  amount          Decimal         @db.Decimal(12, 2)
  transactionType TransactionType @default(P2P) @map("transaction_type")

  // Fraud detection
  isFraud          Boolean @default(false) @map("is_fraud")
  fraudProbability Decimal @default(0.0000) @map("fraud_probability") @db.Decimal(5, 4)
  riskLevel        String  @default("LOW") @map("risk_level") @db.VarChar(10)

  // Balance snapshots (ML features)
  senderBalanceBefore   Decimal @default(0.00) @map("sender_balance_before") @db.Decimal(12, 2)
  receiverBalanceBefore Decimal @default(0.00) @map("receiver_balance_before") @db.Decimal(12, 2)

  // Status
  status TransactionStatus @default(COMPLETED)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  senderId   Int?  @map("sender_id")
  receiverId Int?  @map("receiver_id")
  sender     User? @relation("SenderTransactions", fields: [senderId], references: [id])
  receiver   User? @relation("ReceiverTransactions", fields: [receiverId], references: [id])

  // UPI IDs stored directly (works even without User records)
  senderUpi   String @map("sender_upi") @db.VarChar(100)
  receiverUpi String @map("receiver_upi") @db.VarChar(100)

  alerts Alert[]

  @@index([isFraud], map: "idx_transactions_is_fraud")
  @@index([createdAt(sort: Desc)], map: "idx_transactions_created_at")
  @@index([senderUpi], map: "idx_transactions_sender")
  @@index([receiverUpi], map: "idx_transactions_receiver")
  @@index([status], map: "idx_transactions_status")
  @@map("transactions")
}

enum TransactionType {
  P2P
  P2M
  BILL
  RECHARGE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  FLAGGED
  BLOCKED
}

// ── Alert ───────────────────────────────────────────────
// Fraud alerts generated by the ML system
model Alert {
  id        Int         @id @default(autoincrement())
  type      AlertType
  severity  Severity    @default(MEDIUM)
  title     String      @db.VarChar(200)
  message   String      @db.Text
  isRead    Boolean     @default(false) @map("is_read")
  resolved  Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  userId        Int?         @map("user_id")
  transactionId Int?         @map("transaction_id")
  user          User?        @relation(fields: [userId], references: [id])
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([severity], map: "idx_alerts_severity")
  @@index([isRead], map: "idx_alerts_is_read")
  @@index([createdAt(sort: Desc)], map: "idx_alerts_created_at")
  @@map("alerts")
}

enum AlertType {
  FRAUD_DETECTED
  SUSPICIOUS_ACTIVITY
  HIGH_AMOUNT
  RAPID_TRANSACTIONS
  ACCOUNT_ANOMALY
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
