# ===========================================
# UPI Fraud Detection - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upi_fraud_detection
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- Prisma (single connection URL) ---
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/upi_fraud_detection?schema=public"

# --- Backend (Node.js/Express) ---
NODE_ENV=development
BACKEND_PORT=5000
JWT_SECRET=your_jwt_secret_change_this_in_production
CORS_ORIGIN=http://localhost:5173

# --- ML API (Python/FastAPI) ---
ML_API_PORT=8000
ML_API_HOST=0.0.0.0
MODEL_PATH=./app/models/fraud_model.pkl

# --- Frontend (React/Vite) ---
VITE_API_URL=http://localhost:5000/api
VITE_ML_API_URL=http://localhost:8000
